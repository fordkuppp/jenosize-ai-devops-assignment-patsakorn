# ---- database ----
POSTGRES_USER=jenie
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=jenie
DATABASE_URL=postgresql://jenie:change-me-locally@postgres:5432/jenie
PG_TABLE=chunks

# ---- inference (OpenAI-compatible; swap the URL, never the code) ----
# ollama : http://host.docker.internal:11434/v1
# vllm   : http://host.docker.internal:8000/v1
# floci  : http://floci:4566           (bedrock-runtime)
# stub   : leave LLM_BASE_URL unset    (what CI uses — tests must not need a GPU)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=not-needed-locally

EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BATCH_SIZE=32

# ---- retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=50
HYBRID_SEARCH=true

# ---- chunking ----
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# ---- corpus ----
DATA_DIR=/data

# ---- cost proxy (config, not constants — pricing is per model) ----
COST_PER_1K_PROMPT_USD=0.0005
COST_PER_1K_COMPLETION_USD=0.0015

# ---- ops ----
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin

# ---- aws: floci locally, real endpoints in prod ----
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
