{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service-policy values",
  "type": "object",
  "required": [
    "target",
    "strategy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "name",
        "selector"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Deployment",
            "StatefulSet",
            "DaemonSet"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targetPort": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "selector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          },
          "description": "Pod labels. NetworkPolicy and PodDisruptionBudget select pods directly, so an empty selector would silently match every pod in the namespace."
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "RollingUpdate",
            "Canary",
            "BlueGreen",
            "ABTest"
          ]
        },
        "canary": {
          "type": "object",
          "properties": {
            "stepWeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxWeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "stepWeightPromotion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "blueGreen": {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "mirror": {
              "type": "boolean"
            }
          }
        },
        "abTest": {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "match": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "interval": {
              "type": "string"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "progressDeadlineSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "metrics": {
              "type": "array"
            },
            "webhooks": {
              "type": "array"
            }
          }
        },
        "metricTemplates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "ABTest"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "abTest": {
                "required": [
                  "match"
                ]
              }
            },
            "required": [
              "abTest"
            ],
            "description": "ABTest without a match rule routes nothing to the canary, so analysis never gathers samples and the rollout stalls instead of failing."
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "required": [
            "name",
            "namespace"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "sectionName": {
              "type": "string"
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "timeouts": {
          "type": "object"
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "Local",
            "Global"
          ]
        },
        "requests": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "enum": [
            "Second",
            "Minute",
            "Hour",
            "Day"
          ]
        }
      }
    },
    "circuitBreaker": {
      "type": "object"
    },
    "retry": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "metrics": {
          "type": "array"
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "podDisruption": {
      "type": "object"
    },
    "podMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "string",
          "description": "Container port NAME, not a number."
        },
        "path": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        }
      }
    }
  }
}
