# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# .terraform.lock.hcl IS committed — it pins provider versions *and* their
# checksums, which is what makes `terraform init` reproducible. It is also
# what lets init succeed without re-querying the registry.

# Generated kubeconfigs — one per env, written by the kind provider
**/.kube/

# Secrets seeded into the cluster. Never committed; `make bootstrap` creates
# them, and losing them means regenerating the age key and re-encrypting.
.secrets/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local env
.env

# Holding area while the infra layer is built. Nothing here ships —
# empty it or wire it back in before submitting.
temp/

# .sops.yaml IS committed — it holds only the age *public* key.

# Shared provider cache — see TF_PLUGIN_CACHE_DIR in the Makefile.
.terraform-cache/
